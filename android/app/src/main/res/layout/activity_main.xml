<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="抖音时间管控"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#6200EE"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />

    <!-- 服务状态 -->
    <TextView
        android:id="@+id/tv_service_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="已停止"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#CC0000"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="8dp" />

    <!-- 定时信息 -->
    <TextView
        android:id="@+id/tv_schedule"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="每 60 分钟可用 15 分钟"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- 倒计时 -->
    <TextView
        android:id="@+id/tv_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--:--"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp" />

    <!-- 权限状态 -->
    <TextView
        android:id="@+id/tv_accessibility_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="无障碍服务：未开启"
        android:textSize="14sp"
        android:textColor="#CC0000"
        android:paddingBottom="4dp" />


    <!-- 开始按钮 -->
    <Button
        android:id="@+id/btn_start_service"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="开始管控"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="#6200EE"
        android:layout_marginBottom="12dp" />

    <!-- 设置按钮 -->
    <Button
        android:id="@+id/btn_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="设置"
        android:textSize="16sp"
        android:background="#EEEEEE"
        android:textColor="#333333"
        android:layout_marginBottom="12dp" />

    <!-- 重置按钮 -->
    <Button
        android:id="@+id/btn_reset_schedule"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="重置定时"
        android:textSize="16sp"
        android:background="#EEEEEE"
        android:textColor="#333333"
        android:layout_marginBottom="12dp" />

    <!-- 无障碍设置按钮 -->
    <Button
        android:id="@+id/btn_open_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="开启无障碍服务"
        android:textSize="16sp"
        android:background="#DDDDDD"
        android:textColor="#333333"
        android:layout_marginBottom="12dp" />


</LinearLayout>
